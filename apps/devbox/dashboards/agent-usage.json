{
  "annotations": {"list": []},
  "description": "Local transcript usage for cla, claude-personal, codex, and codex-exec. Raw transcripts stay on the devbox.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"})", "legendFormat": "tokens", "range": true, "refId": "A"}],
      "title": "All-time tokens",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Transcript-backed sessions. A session can span more than one model.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 5, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(devbox_ai_usage_sessions{client=~\"$client\"})", "legendFormat": "sessions", "range": true, "refId": "A"}],
      "title": "Sessions",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Subscription-backed Codex models have a configured cost of zero.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 100}]}, "unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(devbox_ai_usage_estimated_cost_usd{client=~\"$client\",model=~\"$model\"})", "legendFormat": "estimated cost", "range": true, "refId": "A"}],
      "title": "API-equivalent cost",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Time since the devbox last rebuilt the metrics file.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 180}, {"color": "red", "value": 600}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "time() - devbox_ai_usage_collector_last_success_timestamp_seconds", "legendFormat": "age", "range": true, "refId": "A"}],
      "title": "Collector age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Estimated output-token speed during the last hour of recorded activity.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum(increase(devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind=\"output\"}[1h])) / clamp_min(sum(increase(devbox_ai_usage_active_seconds_total{client=~\"$client\",model=~\"$model\"}[1h])), 1)", "legendFormat": "output tokens/s", "range": true, "refId": "A"}],
      "title": "Output speed (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 6,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (client) (increase(devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"}[$__rate_interval]))", "legendFormat": "{{client}}", "range": true, "refId": "A"}],
      "title": "Token activity by client",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (model) (increase(devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"}[$__rate_interval]))", "legendFormat": "{{model}}", "range": true, "refId": "A"}],
      "title": "Token activity by model",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Darker cells contain larger token changes in each time bucket. Prometheus history starts when this collector is enabled.",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "id": 8,
      "options": {"calculate": true, "calculation": {"xBuckets": {"mode": "size", "value": "10m"}, "yBuckets": {"mode": "count", "value": "20"}}, "cellGap": 1, "cellRadius": 0, "cellValues": {"decimals": 0}, "color": {"exponent": 0.5, "fill": "dark-orange", "mode": "scheme", "reverse": false, "scale": "exponential", "scheme": "Oranges", "steps": 64}, "filterValues": {"le": 0}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "tooltip": {"mode": "single", "showColorScale": false, "yHistogram": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "short"}},
      "targets": [{"editorMode": "code", "expr": "sum(increase(devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"}[$__rate_interval]))", "legendFormat": "token change", "range": true, "refId": "A"}],
      "title": "Usage intensity heatmap",
      "type": "heatmap"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "All-time transcript usage grouped by local weekday and hour. This panel includes history from before Prometheus collection started.",
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-GrYlRd"}, "custom": {"align": "auto", "cellOptions": {"mode": "gradient"}, "inspect": false}, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "weekday"}, "properties": [{"id": "custom.cellOptions", "value": {"mode": "auto"}}]}]},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 20},
      "id": 9,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": []},
      "targets": [{"editorMode": "code", "expr": "sum by (weekday, weekday_number, hour) (devbox_ai_usage_hour_of_week_tokens{client=~\"$client\"})", "format": "table", "instant": true, "legendFormat": "", "refId": "A"}],
      "title": "Hour-of-week heatmap",
      "transformations": [
        {"id": "groupingToMatrix", "options": {"columnField": "hour", "rowField": "weekday", "valueField": "Value"}}
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 20},
      "id": 10,
      "options": {"displayLabels": ["percent", "name"], "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["percent", "value"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum by (model) (devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"})", "instant": true, "legendFormat": "{{model}}", "range": false, "refId": "A"}],
      "title": "All-time model share",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29},
      "id": 11,
      "options": {"displayLabels": ["percent", "name"], "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["percent", "value"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum by (kind) (devbox_ai_usage_tokens_total{client=~\"$client\",model=~\"$model\",kind!=\"reasoning\"})", "instant": true, "legendFormat": "{{kind}}", "range": false, "refId": "A"}],
      "title": "Token composition",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 75, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 0, "pointSize": 4, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 29},
      "id": 12,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (client) (increase(devbox_ai_usage_messages_total{client=~\"$client\",model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{client}}", "range": true, "refId": "A"}],
      "title": "Assistant responses by client",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Counterfactual range if codex-exec tokens had used the configured lower and upper Claude models.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "decimals": 2, "unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 37},
      "id": 13,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "devbox_ai_usage_codex_exec_savings_usd", "instant": true, "legendFormat": "{{estimate}} ({{model}})", "range": false, "refId": "A"}],
      "title": "Codex-exec estimated savings",
      "type": "stat"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": ["ai", "devbox", "usage"],
  "templating": {
    "list": [
      {"current": {}, "hide": 0, "includeAll": false, "label": "Prometheus", "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "regex": "", "type": "datasource"},
      {"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(devbox_ai_usage_tokens_total, client)", "includeAll": true, "label": "Client", "multi": true, "name": "client", "options": [], "query": {"query": "label_values(devbox_ai_usage_tokens_total, client)", "refId": "PrometheusVariableQueryEditor-Client"}, "refresh": 1, "regex": "", "sort": 1, "type": "query"},
      {"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(devbox_ai_usage_tokens_total{client=~\"$client\"}, model)", "includeAll": true, "label": "Model", "multi": true, "name": "model", "options": [], "query": {"query": "label_values(devbox_ai_usage_tokens_total{client=~\"$client\"}, model)", "refId": "PrometheusVariableQueryEditor-Model"}, "refresh": 1, "regex": "", "sort": 1, "type": "query"}
