#cloud-config
package_update: true
package_upgrade: false
bootcmd:
  - |
    printf '%s\n' \
      'network:' \
      '  version: 2' \
      '  ethernets:' \
      '    lan:' \
      '      match:' \
      '        name: "en*"' \
      '      dhcp4: true' \
      '      dhcp6: false' \
      >/etc/netplan/50-devbox-lan.yaml
    chmod 600 /etc/netplan/50-devbox-lan.yaml
    netplan generate
    netplan apply
users:
  - default
  - name: stian
    gecos: Stian Froystein
    groups: sudo
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-rsa 
packages:
  - ca-certificates
  - curl
  - gnupg
  - openssh-server
  - python3
  - sudo
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/ssh/sshd_config.d/99-devbox-hardening.conf
    permissions: '0644'
    owner: root:root
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
runcmd:
  - systemctl enable --now ssh
  - systemctl restart ssh
