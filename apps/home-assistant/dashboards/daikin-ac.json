    {
      "id": 11,
      "type": "timeseries",
      "title": "Energy per day",
      "description": "Energy used per day. The query takes the increase of the cumulative energy counter over a fixed one day window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (friendly_name) (increase(homeassistant_sensor_energy_kwh{entity=~\"sensor\\\\..*_ac_measured_cumulative_power_consumption\"}[1d]))",
          "refId": "A",
          "legendFormat": "{{friendly_name}}",
