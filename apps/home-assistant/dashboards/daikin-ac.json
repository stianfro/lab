          },
          "expr": "homeassistant_binary_sensor_state{entity=~\"binary_sensor\\\\..*_ac_fault_status\"}",
          "refId": "A",
          "legendFormat": "{{friendly_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
