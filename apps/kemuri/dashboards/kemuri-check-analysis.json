    {
      "id": 1,
      "type": "stat",
      "title": "Current state",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "columns": [
            {
              "selector": "state",
              "text": "State",
              "type": "string"
            }
          ],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "filters": [],
          "format": "table",
          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "$",
          "source": "url",
          "type": "json",
          "url": "/api/v1/targets/${target:percentencode}/checks/${check:percentencode}",
          "url_options": {
            "data": "",
            "method": "GET"
          },
          "computed_columns": [
            {
              "selector": "state == 'healthy' ? 1 : (state == 'degraded' ? 2 : (state == 'down' ? 3 : 0))",
              "text": "State code",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "gray",
                  "index": 0,
                  "text": "No data"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Healthy"
                },
                "2": {
                  "color": "yellow",
                  "index": 2,
                  "text": "Degraded"
                },
                "3": {
                  "color": "red",
                  "index": 3,
                  "text": "Down"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "State code",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
