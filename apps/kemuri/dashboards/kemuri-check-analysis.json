    {
      "id": 10,
      "type": "heatmap",
      "title": "Latency distribution",
      "description": "Smoke-style latency density. Darker cells contain more latency samples. Missing samples do not enter the distribution.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "columns": [],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "filters": [],
          "format": "table",
          "global_query_id": "",
          "parser": "backend",
          "refId": "Smoke",
          "root_selector": "(\n  $active := $filter([0..96], function($i) {\n    $sum($map($.points, function($point) { $point.histogram_bins[$i] })) > 0\n  });\n  $map($.points, function($point) {\n    $merge([\n      {\"timestamp_ms\": $point.timestamp_ms},\n      $map($active, function($i) {\n        {($string($i = 0 ? 1 : $power(10, $i / 12))): $point.histogram_bins[$i]}\n      })\n    ])\n  })\n)",
          "source": "url",
          "type": "json",
          "url": "/api/v1/targets/${target:percentencode}/checks/${check:percentencode}/series?from_ms=${__timeFrom}&to_ms=${__timeTo}&max_points=300",
          "url_options": {
            "data": "",
            "method": "GET"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "log",
              "log": 2
            }
          }
        },
        "overrides": []
      },
      "options": {
        "bucket": {
          "layout": "le"
        },
        "calculate": false,
        "cellGap": 0,
        "color": {
          "exponent": 0.7,
          "fill": "dark-blue",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Blues",
          "steps": 48
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 0
        },
        "legend": {
          "show": true,
          "showLegend": true
        },
        "mode": "rows",
        "rowsFrame": {
          "layout": "le"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "µs"
        },
        "yAxisLabels": "auto",
        "yAxisReverse": false
      },
