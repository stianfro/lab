        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max(kemuri_build_info{job=~\"$job\", instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
